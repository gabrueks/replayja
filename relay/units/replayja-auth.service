# Sidecar local de autenticação (forward_auth do Caddy), porta 9998, loopback.
[Unit]
Description=Replay ja — sidecar de autenticacao do relay
After=network-online.target

[Service]
EnvironmentFile=/etc/replayja/rec.env
ExecStart=/usr/bin/python3 /opt/replayja-relay/auth-sidecar.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
