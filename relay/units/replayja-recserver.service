# Índice + playlists + /clip + /thumb + poda + watchdog. Sem estado precioso:
# se cair, reinicia e reconstrói do disco.
[Unit]
Description=Replay ja — rec-server (indice/playlists/clip/poda)
After=network-online.target
RequiresMountsFor=/srv/rec

[Service]
EnvironmentFile=/etc/replayja/rec.env
ExecStart=/usr/bin/python3 /opt/replayja-relay/rec-server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
