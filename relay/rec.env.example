# /etc/replayja/rec.env — modelo. O arquivo REAL contém segredos e NÃO é
# versionado. Modo 600, dono root.
#
#   sudo install -d -m 700 /etc/replayja
#   sudo install -m 600 rec.env.example /etc/replayja/rec.env
#   sudo nano /etc/replayja/rec.env      # preencher os quatro segredos
#
# Segredos: gere cada um com `openssl rand -base64 32 | tr -d '=+/' | cut -c1-40`.

# ─── Identidade e API ──────────────────────────────────────────────────────
# Base da API do Replay já. TEM de terminar em /api — os caminhos do contrato
# são /relay/cameras, /relay/clip-jobs, /relay/health.
API_URL=https://replayja.com.br/api
# Nome deste relay. Vai no `relayId` de todo relatório de saúde e é o que
# separa relay-1 de relay-2 quando a 7ª arena entrar.
RELAY_ID=relay-1

# RELAY → API. É o `x-relay-key` de `/relay/*`. Quem tiver isto consegue ler a
# lista de câmeras COM AS CHAVES DE INGEST — trate como senha de banco.
RELAY_KEY=

# API → RELAY. É o `Authorization: Bearer` do `POST /jobs` e do `GET /stats`.
# Separado do RELAY_KEY de propósito: as direções são diferentes, e
# comprometer um não pode dar o outro.
RELAY_TOKEN=

# Assina o token de leitura de vídeo (o `/t/<token>/...`). **DEVE bater
# exatamente com o valor na Vercel.** Se divergir, TODO o vídeo cai com 401 —
# é o primeiro item do backup por isso, e o primeiro lugar a olhar quando o
# app diz "a sessão de vídeo expirou".
RELAY_TOKEN_SECRET=

# ─── Disco e retenção ──────────────────────────────────────────────────────
REC_ROOT=/srv/rec
REC_DB=/var/lib/replayja/rec.db
# Retenção da SESSÃO COMPLETA, em horas. 72 = 3 dias (piloto enxuto da ADR
# §9); 168 = 7 dias (piloto confortável). É a MAIOR alavanca de custo do
# sistema inteiro: cair de 7 para 3 dias tira US$ 456/mês a 20 arenas. Mexer
# aqui exige reiniciar o rec-server.
RETAIN_HOURS=72
# Rede de segurança: acima de DISK_HIGH a poda apaga as sessões mais antigas
# até voltar abaixo de DISK_LOW, independente da retenção. Gravador nunca pode
# parar por disco cheio.
DISK_HIGH=0.85
DISK_LOW=0.78

# ─── Câmeras ───────────────────────────────────────────────────────────────
# DERIVADO, NÃO EDITADO À MÃO. Quem escreve esta linha é o sync-cameras.sh, a
# partir de `GET /relay/cameras`. Mexer aqui funciona até o próximo tique (2
# min), e aí o sync desfaz.
RECORD_CAMS=""
# A faixa que o Security Group abre de fato. Só serve para o sync AVISAR
# quando uma câmera vem com porta fora dela — o sintoma do lado de fora é um
# timeout de 8 s que não diz nada, e no Sentinela isso custou meio dia.
RTMP_PORTS_OPEN=19350-19399

# ─── Janela ao vivo e /clip ────────────────────────────────────────────────
LIVE_WINDOW_S=1800
CLIP_MAX_MS=300000
CLIP_SLOTS=2
CLIP_TIMEOUT_S=120

# ─── Worker de clipe ───────────────────────────────────────────────────────
WORKER_SLOTS=2
WORKER_POLL_S=2
# Bitrate de saída do clipe. 4 Mbps sobre uma fonte de 3 Mbps dá folga para o
# overlay sem inventar qualidade que a fonte não tem (ADR §5). O job pode
# trazer `encodeProfile` e sobrepor isto.
WORKER_BITRATE_KBPS=4000
WORKER_MAXRATE_KBPS=4500
# Quanto tempo o recorte BRUTO fica em disco depois do clipe pronto, para
# "estender lance" e para reprocessar quando a arena troca o logo.
WORKER_RAW_RETAIN_H=48

# ─── Marca d'água ──────────────────────────────────────────────────────────
# TODAS opcionais: os padrões abaixo são os valores do código e correspondem ao
# que o `setup.sh` instala. Estão aqui documentadas porque a marca é a única
# parte do clipe que o PARCEIRO vê como sendo dele.
#
# A do Replay já é ARQUIVO LOCAL, versionado no repo, de propósito: ela é o
# padrão de toda arena sem logo, e fazer o caso mais comum depender de rede,
# bucket e credencial seria pôr o comum na dependência do frágil.
# WORKER_WM_DEFAULT=/opt/replayja-relay/watermark-replayja.png
# WORKER_WM_ASSINATURA=/opt/replayja-relay/watermark-replayja-assinatura.png
# Cache do PNG do PARCEIRO, baixado por URL assinada no claim. Chaveado por
# (caminho no bucket, versão) — nunca pela URL, que é reassinada a cada claim.
# WORKER_WM_CACHE=/var/cache/replayja/watermark
# Geometria da composição, em % da LARGURA do vídeo (decisão 9 do PLANO).
# WORKER_WM_MARGEM_PCT=2.5
# WORKER_WM_PADRAO_PCT=14              a nossa quando não há logo do parceiro
# WORKER_WM_ASSINATURA_PCT=10          a nossa ao lado da do parceiro
# WORKER_WM_ASSINATURA_OPACIDADE=0.6
# Como se reivindica um job. O padrão segue o `openapi.yaml`; o briefing da
# task A1 pedia `POST /relay/clip-jobs/claim`. Trocar custa estas duas linhas.
# WORKER_CLAIM_PATH=/relay/clip-jobs/claim
# WORKER_CLAIM_METHOD=POST

# ─── Miniaturas ────────────────────────────────────────────────────────────
# Todas opcionais; só entram aqui para mudar um padrão.
# THUMB_W=320
# THUMB_QUANTUM_MS=2000
# THUMB_RETAIN_H=48
# THUMB_MAX_BYTES=2147483648

# ─── Índice ────────────────────────────────────────────────────────────────
# Teto do WAL. Acima disto alguma coisa segura um snapshot e o checkpoint não
# consegue avançar — ver o runbook no README. 512 MB é ~8× um dia saudável.
WAL_MAX_BYTES=536870912
